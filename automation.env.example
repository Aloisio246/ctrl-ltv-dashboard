EVOLUTION_REDIS_IMAGE=redis:7-alpine
EVOLUTION_POSTGRES_DB=evolution
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=ALTERAR_COM_SENHA_FORTE
EVOLUTION_REDIS_PASSWORD=ALTERAR_COM_SENHA_FORTE
