# Imagens fixadas: atualize conscientemente, nunca use latest em produção.
AUTOMATION_NETWORK=ctrl-ltv-automation
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.6.4
N8N_POSTGRES_IMAGE=postgres:16-alpine
N8N_REDIS_IMAGE=redis:7-alpine
N8N_POSTGRES_DB=n8n
N8N_POSTGRES_USER=n8n
N8N_POSTGRES_PASSWORD=ALTERAR_COM_SENHA_FORTE
N8N_REDIS_PASSWORD=ALTERAR_COM_SENHA_FORTE
N8N_ENCRYPTION_KEY=ALTERAR_COM_CHAVE_ALEATORIA_DE_64_CARACTERES
N8N_DOMAIN=n8n.seudominio.com
N8N_WEBHOOK_DOMAIN=webhook-n8n.seudominio.com
N8N_TIMEZONE=America/Cuiaba
N8N_WORKER_CONCURRENCY=5

EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.7
